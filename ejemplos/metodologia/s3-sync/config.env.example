#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# config.env — the ONLY file you edit per machine.  Copy to `config.env`.
#
# ⚠️⚠️ NEVER COMMIT, NEVER SYNC, NEVER PACKAGE THE REAL `config.env`.
# It names your bucket, your account profiles and this machine's role. It is also
# the reason every script beside it is publishable: they are pure mechanism and
# read everything from here. (Measured on the real installation: genericising the
# eleven scripts for this course changed **one line in one file**. All the
# environment-specific content was already in this one place.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────────────────────
BUCKET="<your-bucket>"
REGION="<your-region>"
PREFIX="<team>/<repo>/data"      # team/repo folder; siblings live beside it

# Two profiles, deliberately. The write profile is the ONLY one that can put
# objects; everything else runs read-only. Least privilege is a habit here, not
# a requirement — but a push configured against the read profile fails on a line
# that looks entirely correct, so name them clearly.
PROFILE="${PROFILE:-<write-profile>}"
READ_PROFILE="${READ_PROFILE:-$PROFILE}"

# ── This machine ─────────────────────────────────────────────────────────────
LOCAL_DATA="<absolute-path-to>/data"     # the working copy (gitignored)
MOUNT_DIR="${HOME}/s3-<name>-data"       # READ-ONLY live view

MACHINE_NAME="<machine>"                 # unique; names this machine's ledger file
MACHINE_ROLE="contributor"               # contributor | publisher
# ⚠️ Exactly ONE machine is `publisher`. Two publishers silently overwrite each
# other's hand-authored labels on the derived artifact, and versioning cannot
# merge — it hands back one of the two. Moving the role is a deliberate act
# (release the baton, then claim it), not a config edit done in passing.

# ── Shared hub files ─────────────────────────────────────────────────────────
# Files more than one person edits on the same day. Everything else is
# partitioned by owner and needs no coordination at all.
#
# These get two protections: an append-only check on pull, and a refusal on push
# when the stored copy moved after your last sync. ⚠️ You need BOTH — the pull
# check protects you, and the push check protects your colleague. Shipping only
# the first is the mistake this list exists to prevent.
LEDGERS=(
  "changes/STATUS.md"
  "changes/TICKETS.md"
  "changes/FOLLOWUPS.md"
  "changes/TEST_MAP.md"
  "changes/CUSTOMER_GUIDANCE.md"
)

# ── Roots ────────────────────────────────────────────────────────────────────
# Sync one root at a time rather than pointing the tool at the tree.
# ⚠️ `aws s3 sync` stats the WHOLE source tree before applying any --exclude, so
# aiming it at the parent pays for every node_modules/ it will never upload.
SYNC_ROOTS=( "knowledge-graph" "changes"
             fixtures docs archive )

# ── Filters, per root: FILTERS_<root with - replaced by _> ───────────────────
#
# ⚠️⚠️ FOUR RULES, EACH LEARNED THE EXPENSIVE WAY:
#
#  1. ORDER MATTERS — filters apply in sequence and the LAST match wins. An
#     `--exclude` placed before a broader `--include` is silently overridden.
#     Catch it by canarying the filter, not by reading it.
#  2. `--include` IS CASE-SENSITIVE. A lowercase extension list silently dropped
#     30 documents named *.DOC / *.DOCX / *.PNG. Every extension needs its
#     uppercase twin.
#  3. USE PREFIX GLOBS, NOT `<dir>/*`, for "exclude this family". `_snapshot/*`
#     matches the bare `_snapshot/` directory and NOT `_snapshot.2026-08-13/` —
#     which is what actually existed on disk.
#  4. PER-MACHINE FILES MUST BE EXCLUDED. Any file that is *about this machine*
#     on a shared key gets overwritten by whoever pushes last, and the next pull
#     hands it back wrong. The worst direction is a contributor receiving the
#     publisher's identity card: their agent then reads "you are the publisher"
#     and does the one thing single-writer exists to prevent.

FILTERS_knowledge_graph=(
  --exclude "*"
  --include "*.md" --include "*.py" --include "*.sh"
  --include "<hand-authored-labels>.json"   # SOURCE, not output — nothing regenerates it
  --include "_corpus/*" --include "output/*"
  --include "refresh_queue/*"    # one file per request -> no last-writer-wins collisions
  --exclude "__pycache__/*"
  --exclude "_snapshot*"         # rule 3: prefix glob, not _snapshot/*
  --exclude "*-bak" --exclude "*.bak" --exclude "*.bak-*"
)

FILTERS_changes=(
  --exclude "*"
  --include "_activity/*"        # per-machine sync ledger, one file per machine
  --include "*.md" --include "*.json" --include "*.py" --include "*.csv"
  --include "*.docx" --include "*.pdf" --include "*.png"
  --include "*.DOCX" --include "*.PDF" --include "*.PNG"   # rule 2

  # ⚠️ Raw log exports can carry signed URLs and temporary credentials. They are
  # captured ON PURPOSE as evidence of a bug — which is exactly why they are the
  # strings you least want in shared storage. Scan the WHOLE record before the
  # first push, not a diff, and canary the scanner before believing it.
  --exclude "*logs-insights-results.csv"
  --exclude "*log-events-viewer-result.csv"

  # ⚠️⚠️ MUST BE LAST (rule 1). Anything added below re-opens the hole.
  --exclude "IDENTITY.md"        # rule 4: per-machine identity card
  --exclude "PACK_BUILD.txt"     # rule 4: which build THIS machine installed
)

FILTERS_fixtures=() ; FILTERS_docs=() ; FILTERS_archive=()

# ── Junk that can live inside any synced root ────────────────────────────────
JUNK_ARGS=(
  --exclude "*/node_modules/*" --exclude "node_modules/*"
  --exclude "*/.git/*"         --exclude ".DS_Store"
  --exclude "*/__pycache__/*"  --exclude "*.pyc"
  --exclude "~$*"              # Office lock files, left during directory scans
)

SCOPE_ARGS=()   # reserved
